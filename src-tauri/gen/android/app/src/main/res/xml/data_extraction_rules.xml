<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12以降のバックアップと端末間の移行。GitHubのトークンは移さない -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="github/token.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="github/token.json" />
    </device-transfer>
</data-extraction-rules>
